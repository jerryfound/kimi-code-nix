#!/bin/sh
# Secret scan before commit. Fail-open by design: gitleaks is optional
# locally, the CI workflow (.github/workflows/gitleaks.yml) is the
# enforcing layer. Enable with: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found; skipping secret scan (install: nix profile add nixpkgs#gitleaks)" >&2
  exit 0
fi

exec gitleaks git --staged --verbose
